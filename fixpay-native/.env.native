# FixPay Native (Capacitor) — runtime environment for `vite build --mode native`.
# The PWA reads this file (via envDir) so the two deployments differ ONLY here:
# web keeps same-origin /api proxying; the native app must call the API absolutely.
#
# Point this at your deployed Laravel API. No secrets belong in Vite env files.
VITE_API_URL=https://api.fixpay.ng/api
VITE_USE_MOCK=false
