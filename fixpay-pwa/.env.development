# FixPay PWA — Live Only
# Vite proxy forwards /api and /sanctum to Laravel on port 8001.
# VITE_API_URL is empty so Axios uses same-origin — proxy handles forwarding, no CORS.

VITE_API_URL=

# Keycloak (customers realm)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=customers
VITE_KEYCLOAK_CLIENT_ID=fixpay-pwa